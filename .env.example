# Git Sync Configuration for Thinking Partner MCP

# Enable/disable Git sync (default: true)
THINKING_PARTNER_GIT_SYNC=true

# Enable/disable automatic sync on save (default: true)
THINKING_PARTNER_AUTO_SYNC=true

# Git remote repository URL (required for sync)
# Example: git@github.com:yourusername/thinking-partner-data.git
# Example: https://github.com/yourusername/thinking-partner-data.git
THINKING_PARTNER_GIT_REMOTE=

# Optional: Override the default data path for testing
# MCP_TEST_DATA_PATH=/path/to/test/data